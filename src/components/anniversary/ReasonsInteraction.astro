---
type Props = {
  reasons: readonly string[];
  instruction: string;
};

const { reasons, instruction } = Astro.props;
---

<div class="reasons-interaction" data-reasons data-reasons-values={JSON.stringify(reasons)}>
  <p class="reasons-interaction__instruction" data-animate>
    {instruction}
  </p>
  <button
    class="reason-trigger"
    type="button"
    data-reason-trigger
    aria-label="Descubrir la primera razón"
    aria-describedby="reason-counter"
  >
    <span class="reason-trigger__icon" aria-hidden="true">
      ♥
    </span>
    <span class="reason-trigger__halo"></span>
  </button>
  <div class="reason-copy" aria-live="polite" aria-atomic="true">
    <p data-reason-text>Una razón especial te espera.</p>
    <span id="reason-counter" data-reason-counter>
      Razón 0 de {reasons.length}
    </span>
  </div>
</div>
